{
  "$schema": "https://github.com/longbridge/gpui-component/raw/refs/heads/main/.theme-schema.json",
  "name": "Magenta",
  "author": "Magenta",
  "themes": [
    {
      "name": "Magenta Light",
      "mode": "light",
      "font.size": 15,
      "radius": 9,
      "radius.lg": 18,
      "shadow": true,
      "colors": {
        "background": "#F7F2F5",
        "foreground": "#2C2228",

        "border": "#E8D9E1",
        "input.border": "#DDC7D2",
        "ring": "#B93470",

        "accent.background": "#F7E5EE",
        "accent.foreground": "#57283E",

        "muted.background": "#F2EAEF",
        "muted.foreground": "#766871",

        "popover.background": "#FFFFFF",
        "popover.foreground": "#2C2228",

        "primary.background": "linear-gradient(135deg, #B93470, #D86559)",
        "primary.hover.background": "linear-gradient(135deg, #C7407C, #E17164)",
        "primary.active.background": "linear-gradient(135deg, #A72D64, #C65A50)",
        "primary.foreground": "#FFF9FC",

        "secondary.background": "#F3EAF0",
        "secondary.hover.background": "#EDDFE7",
        "secondary.active.background": "#E5D3DD",
        "secondary.foreground": "#51424A",

        "button.background": "#FFFFFF",
        "button.hover.background": "#F5F1F3",
        "button.active.background": "#EDE7EA",
        "button.foreground": "#2C2228",

        "selection.background": "#B9347033",

        "sidebar.background": "#FBF6F8",
        "sidebar.foreground": "#55464E",
        "sidebar.border": "#E8D9E1",

        "sidebar.accent.background": "#F7E5EE",
        "sidebar.accent.foreground": "#3F353A",

        "sidebar.primary.background": "linear-gradient(135deg, #B93470, #D86559)",
        "sidebar.primary.foreground": "#FFF9FC",

        "tab.background": "#00000000",
        "tab.active.background": "#FFFFFF",
        "tab.active.foreground": "#34262E",
        "tab.foreground": "#766871",

        "tab_bar.background": "#FBF6F8",
        "tab_bar.segmented.background": "#F2E8EE",

        "title_bar.background": "#F7F2F5",
        "title_bar.border": "#E8D9E1",

        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#9999994D",
        "scrollbar.thumb.hover.background": "#73737366",

        "danger.background": "#C84D61",
        "danger.foreground": "#FFFFFF",

        "base.red": "#C84D61",
        "base.green": "#3A805E",
        "base.yellow": "#9B6E32",
        "base.blue": "#5274A8",
        "base.magenta": "#B74377",
        "base.cyan": "#3E7B7C"
      },
      "highlight": {
        "editor.foreground": "#342A30",
        "editor.background": "#FFFDFE",
        "editor.gutter.background": "#FBF6F8",
        "editor.active_line.background": "#F7EDF2",
        "editor.line_number": "#A5949D",
        "editor.active_line_number": "#57454F",

        "created.background": "#DDF1E5",
        "deleted.background": "#F6E0E4",
        "modified.background": "#F5ECD9",

        "syntax": {
          "attribute": { "color": "#94506F" },
          "boolean": { "color": "#AD6B36" },
          "comment": {
            "color": "#8D8086",
            "font_style": "italic"
          },
          "constant": { "color": "#AD6B36" },
          "constructor": { "color": "#8061A6" },
          "function": { "color": "#70569B" },
          "keyword": { "color": "#AD3D70" },
          "number": { "color": "#AD6B36" },
          "operator": { "color": "#985D70" },
          "property": { "color": "#94506F" },
          "punctuation": { "color": "#7E7479" },
          "string": { "color": "#39775A" },
          "type": { "color": "#4D6F98" },
          "variable.special": { "color": "#AD3D70" }
        }
      }
    },
    {
      "name": "Magenta Dark",
      "mode": "dark",
      "font.size": 15,
      "radius": 9,
      "radius.lg": 18,
      "shadow": true,
      "colors": {
        "background": "#0D0A0F",
        "foreground": "#F5F0F3",

        "border": "#332532",
        "input.border": "#463044",
        "ring": "#D84C8B",

        "accent.background": "#2A1823",
