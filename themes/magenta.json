        "secondary.foreground": "#EAE4E7",

        "button.background": "#19131A",
        "button.hover.background": "#251A23",
        "button.active.background": "#30212D",
        "button.foreground": "#F2EDF0",

        "selection.background": "#D84C8B3D",

        "sidebar.background": "#151017",
        "sidebar.foreground": "#DDD5DA",
        "sidebar.border": "#332532",

        "sidebar.accent.background": "#2A1823",
        "sidebar.accent.foreground": "#F6EDF1",

        "sidebar.primary.background": "linear-gradient(135deg, #D84C8B, #EF776B)",
        "sidebar.primary.foreground": "#FFF9FC",

        "tab.background": "#00000000",
        "tab.active.background": "#241822",
        "tab.active.foreground": "#F4EEF1",
        "tab.foreground": "#A2949D",

        "tab_bar.background": "#151017",
        "tab_bar.segmented.background": "#201720",

        "title_bar.background": "#0D0A0F",
        "title_bar.border": "#332532",

        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#8F8F8F4D",
        "scrollbar.thumb.hover.background": "#B0B0B066",

        "danger.background": "#E25D73",
