{
  "$schema": "https://github.com/longbridge/gpui-component/raw/refs/heads/main/.theme-schema.json",
  "name": "Magenta",
  "author": "Magenta",
  "themes": [
    {
      "name": "Magenta Light",
      "mode": "light",
      "font.size": 15,
      "radius": 8,
      "radius.lg": 12,
      "shadow": true,
      "colors": {
        "background": "#FCFAFB",
        "foreground": "#292427",

        "border": "#E6E0E3",
        "input.border": "#D8D0D5",
        "ring": "#C84A80",

        "accent.background": "#F3E8EE",
        "accent.foreground": "#57283E",

        "muted.background": "#F4F1F3",
        "muted.foreground": "#786F74",

        "popover.background": "#FFFFFF",
        "popover.foreground": "#292427",

        "primary.background": "linear-gradient(135deg, #BB3F73, #D35A7C)",
        "primary.hover.background": "linear-gradient(135deg, #C74A7D, #DE6687)",
        "primary.active.background": "linear-gradient(135deg, #A83666, #BF4E70)",
        "primary.foreground": "#FFF9FC",

        "secondary.background": "#F0EBEE",
        "secondary.hover.background": "#EAE3E7",
        "secondary.active.background": "#E2D9DE",
        "secondary.foreground": "#51484D",

        "button.background": "#FFFFFF",
        "button.hover.background": "#F5F1F3",
        "button.active.background": "#EDE7EA",
        "button.foreground": "#292427",

        "selection.background": "#C84A8029",

        "sidebar.background": "#F7F4F6",
        "sidebar.foreground": "#554D51",
        "sidebar.border": "#E3DDE0",

        "sidebar.accent.background": "#EEE7EB",
        "sidebar.accent.foreground": "#3F353A",

        "sidebar.primary.background": "linear-gradient(135deg, #BB3F73, #D35A7C)",
        "sidebar.primary.foreground": "#FFF9FC",

        "tab.background": "#00000000",
        "tab.active.background": "#FFFFFF",
        "tab.active.foreground": "#40373C",
        "tab.foreground": "#7C7277",

        "tab_bar.background": "#F7F4F6",
        "tab_bar.segmented.background": "#EFEAED",

        "title_bar.background": "#FCFAFB",
        "title_bar.border": "#E6E0E3",

        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#9999994D",
        "scrollbar.thumb.hover.background": "#73737366",

        "danger.background": "#C84D61",
        "danger.foreground": "#FFFFFF",

        "base.red": "#C84D61",
        "base.green": "#3A805E",
        "base.yellow": "#9B6E32",
        "base.blue": "#5274A8",
        "base.magenta": "#B74377",
        "base.cyan": "#3E7B7C"
      },
      "highlight": {
        "editor.foreground": "#363033",
        "editor.background": "#FFFFFF",
        "editor.gutter.background": "#FAF7F9",
        "editor.active_line.background": "#F4EFF2",
        "editor.line_number": "#A69BA1",
        "editor.active_line_number": "#574D52",

        "created.background": "#DDF1E5",
        "deleted.background": "#F6E0E4",
        "modified.background": "#F5ECD9",

        "syntax": {
          "attribute": { "color": "#94506F" },
          "boolean": { "color": "#AD6B36" },
          "comment": {
            "color": "#8D8086",
            "font_style": "italic"
          },
          "constant": { "color": "#AD6B36" },
          "constructor": { "color": "#8061A6" },
          "function": { "color": "#70569B" },
          "keyword": { "color": "#AD3D70" },
          "number": { "color": "#AD6B36" },
          "operator": { "color": "#985D70" },
          "property": { "color": "#94506F" },
          "punctuation": { "color": "#7E7479" },
          "string": { "color": "#39775A" },
          "type": { "color": "#4D6F98" },
          "variable.special": { "color": "#AD3D70" }
        }
      }
    },
    {
      "name": "Magenta Dark",
      "mode": "dark",
      "font.size": 15,
      "radius": 8,
      "radius.lg": 12,
      "shadow": true,
      "colors": {
        "background": "#0F0C10",
        "foreground": "#F4F1F3",

        "border": "#2A2329",
        "input.border": "#352C33",
        "ring": "#D65A92",

        "accent.background": "#211820",
        "accent.foreground": "#F8EAF1",

        "muted.background": "#191419",
        "muted.foreground": "#A0969B",

        "popover.background": "#161217",
        "popover.foreground": "#F4F1F3",

        "primary.background": "linear-gradient(135deg, #C8467D, #D85E80)",
        "primary.hover.background": "linear-gradient(135deg, #D25187, #E0698B)",
        "primary.active.background": "linear-gradient(135deg, #B63D70, #C95274)",
        "primary.foreground": "#FFF9FC",

        "secondary.background": "#1D171D",
        "secondary.hover.background": "#261D24",
        "secondary.active.background": "#30242D",
        "secondary.foreground": "#EAE4E7",

        "button.background": "#171217",
        "button.hover.background": "#211920",
        "button.active.background": "#2A2028",
        "button.foreground": "#F2EDF0",

        "selection.background": "#D65A9233",

        "sidebar.background": "#121014",
        "sidebar.foreground": "#D9D3D6",
        "sidebar.border": "#241D23",

        "sidebar.accent.background": "#211820",
        "sidebar.accent.foreground": "#F6EDF1",

        "sidebar.primary.background": "linear-gradient(135deg, #C8467D, #D85E80)",
        "sidebar.primary.foreground": "#FFF9FC",

        "tab.background": "#00000000",
        "tab.active.background": "#1C161C",
        "tab.active.foreground": "#F4EEF1",
        "tab.foreground": "#9A9095",

        "tab_bar.background": "#121014",
        "tab_bar.segmented.background": "#1B151B",

        "title_bar.background": "#100D11",
        "title_bar.border": "#241D23",

        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#8F8F8F4D",
        "scrollbar.thumb.hover.background": "#B0B0B066",

        "danger.background": "#E25D73",
        "danger.foreground": "#FFFFFF",

        "base.red": "#E25D73",
        "base.green": "#69B98D",
        "base.yellow": "#D4A960",
        "base.blue": "#79A2D8",
        "base.magenta": "#D86A9F",
        "base.cyan": "#68B8B6"
      },
      "highlight": {
        "editor.foreground": "#E8E3E6",
        "editor.background": "#111013",
        "editor.gutter.background": "#131014",
        "editor.active_line.background": "#1B161A",
        "editor.line_number": "#70676C",
        "editor.active_line_number": "#CFC7CB",

        "created.background": "#163025",
        "deleted.background": "#341D25",
        "modified.background": "#31291B",

        "error.background": "#341D25",
        "error.border": "#E25D73",

        "warning.background": "#31291B",
        "warning.border": "#D4A960",

        "syntax": {
          "attribute": { "color": "#D38CAF" },
          "boolean": { "color": "#DCA66C" },
          "comment": {
            "color": "#786D73",
            "font_style": "italic"
          },
          "constant": { "color": "#DCA66C" },
          "constructor": { "color": "#AB96D6" },
          "function": { "color": "#9F90D0" },
          "keyword": { "color": "#D86B9F" },
          "number": { "color": "#DCA66C" },
          "operator": { "color": "#C77F92" },
          "property": { "color": "#D38CAF" },
          "punctuation": { "color": "#8F8389" },
          "string": { "color": "#78BB8E" },
          "type": { "color": "#78A8D0" },
          "variable.special": { "color": "#D86B9F" }
        }
      }
    }
